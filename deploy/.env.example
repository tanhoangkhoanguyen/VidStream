# Copy to deploy/.env. Generate each secret: openssl rand -base64 32
VIDSTREAM_IMAGE=vidstream:dev
# *.localhost gets a local certificate from Caddy; Label Studio is at dev.<domain>.
VIDSTREAM_DOMAIN=vidstream.localhost

# Box app (developer console). Redirect URI: https://<VIDSTREAM_DOMAIN>/login/oauth2/code/box
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=

# Encrypts Box tokens in the database. Changing it signs everyone out of background work.
VIDSTREAM_TOKEN_KEY=

POSTGRES_PASSWORD=
VIDSTREAM_DB_PASSWORD=
LS_DEV_DB_PASSWORD=
LS_DEV_SECRET_KEY=
